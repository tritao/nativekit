@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if("@NK_BACKEND_GTK_AVAILABLE@")
    find_dependency(PkgConfig)
    pkg_check_modules(GTK3 REQUIRED IMPORTED_TARGET gtk+-3.0)
    pkg_check_modules(WEBKITGTK REQUIRED IMPORTED_TARGET webkit2gtk-4.1)
endif()
if(@NK_NET_BACKEND_CURL@)
    find_dependency(CURL)
endif()
if(@NK_BUILD_GPU@ OR @NK_BUILD_UI@)
    if(NOT @NK_BUILD_SHARED@ AND
       ("@NK_SOKOL_BACKEND@" STREQUAL "glcore" OR @NK_BUILD_GPU_BACKEND_MATRIX@))
        find_dependency(OpenGL)
    endif()
endif()
if("@NK_STATIC_UI_EXPORTS@")
    find_dependency(Threads)
    if("@NKUI_HAS_FONTCONFIG@")
        find_dependency(PkgConfig)
        pkg_check_modules(FONTCONFIG REQUIRED IMPORTED_TARGET fontconfig)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/NativeKitTargets.cmake")
check_required_components(NativeKit)
