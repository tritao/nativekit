		 */
		matrix: array<f32, 6> @offset(8);
	}
	/**
	 * 16-bit opcode identifying one display-list command record.
	 */
	type nkui_command_opcode = u16;
	/**
	 * Opaque handle for a retained display list.
	 */
	handle nkui_display_list : u32;
	/**
	 * Opaque retained layout session used by a Haxe-owned component tree.
	 */
	handle nkui_layout_session : u32;
	/**
	 * Opaque handle for a renderer and its backend resources.
	 */
	handle nkui_renderer : u32;
	/**
	 * Opaque handle for a path, paint, image, font collection, or text layout.
	 */
	handle nkui_resource : u32;
}
