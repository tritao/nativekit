		 */
		value: f32 @offset(8);
	}
	/**
	 * Payload for NKUI_COMMAND_STROKE_PATH.
	 */
	struct nkui_stroke_path_command @layout(28, 4) {
		/**
		 * Command record header.
		 */
		header: nkui_command_header @offset(0);
		/**
		 * Path resource to stroke.
		 */
		path: nkui_resource @offset(8);
		/**
		 * Stroke width in logical pixels; must be positive and finite.
		 */
		width: f32 @offset(12);
		/**
		 * End-cap style for open contours.
		 */
		line_cap: nkui_path_line_cap @offset(16);
		/**
		 * Join style for connected segments.
		 */
		line_join: nkui_path_line_join @offset(20);
		/**
