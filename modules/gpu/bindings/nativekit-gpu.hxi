	extern fn nkgpu_shader_destroy(renderer: nkgpu_renderer, shader: nkgpu_shader) -> nkgpu_result;
	/**
	 * Creates a shader from a shader builder and consumes the builder.
	 *
	 * On NKGPU_OK, writes the shader handle to `out_shader`. The builder is no
	 * longer valid after this call, including when shader creation fails.
	 */
	extern fn nkgpu_shader_end(builder: nkgpu_shader_builder, out_shader: ptr<nkgpu_shader> @out) -> nkgpu_result;
	/**
	 * Describes a storage-buffer binding with explicit read-only metadata.
	 */
	extern fn nkgpu_shader_storage_buffer(builder: nkgpu_shader_builder, view_slot: u32, stage: nkgpu_shader_stage, readonly: u32) -> nkgpu_result;
	/**
	 * Describes a compute storage-image binding and its access format.
	 */
	extern fn nkgpu_shader_storage_image(builder: nkgpu_shader_builder, view_slot: u32, format: nkgpu_image_format, writeonly: u32) -> nkgpu_result;
	/**
	 * Describes a 2D filtering texture binding in a shader builder.
	 *
	 * `view_slot` and `sampler_slot` are the slots used later by nkgpu_apply_image()
	 * and nkgpu_apply_sampler(). `name` is the UTF-8 GLSL combined texture/sampler
	 * name; HLSL5 and MSL use the view and sampler slots directly. `stage` selects
	 * the vertex or fragment shader.
	 */
	extern fn nkgpu_shader_texture(builder: nkgpu_shader_builder, view_slot: u32, sampler_slot: u32, stage: nkgpu_shader_stage, name: utf8) -> nkgpu_result;
	/**
	 * Describes one member of a shader uniform block.
	 *
	 * `name` is the UTF-8 GLSL uniform member name. HLSL5 and MSL use the block
	 * size and caller-provided bytes directly. `array_count` describes an array
	 * and zero is treated as one element. Cross-backend blocks use std140 layout.
	 */
	extern fn nkgpu_shader_uniform(builder: nkgpu_shader_builder, block_slot: u32, member_index: u32, name: utf8, type: nkgpu_uniform_type, array_count: u32) -> nkgpu_result;
	/**
	 * Describes one shader uniform block in a shader builder.
	 *
	 * `slot` is the block binding slot, `stage` selects the vertex, fragment, or
	 * compute shader, and `size` is the block's byte size. The uniform data later supplied
	 * to nkgpu_apply_uniforms() must use the same layout and size.
	 */
	extern fn nkgpu_shader_uniform_block(builder: nkgpu_shader_builder, slot: u32, stage: nkgpu_shader_stage, size: u32) -> nkgpu_result;
	/**
	 * Submits a command stream after checking its explicit ABI version.
	 */
	extern fn nkgpu_submit_command_stream(renderer: nkgpu_renderer, desc: ptr<const<nkgpu_command_stream_desc>>) -> nkgpu_result;
	/**
	 * Submits a packed little-endian command stream in the active frame.
	 *
	 * Each record starts with two little-endian uint32 values: an opcode and the
	 * record's total byte size, including its 8-byte header. The payload layouts
	 * are documented by the NKGPU_COMMAND_* constants. A uniform record contains
	 * slot, byte count, and that many uniform bytes. The stream must contain whole
	 * records with no trailing bytes; submission stops at the first invalid record.
	 */
	extern fn nkgpu_submit_commands(renderer: nkgpu_renderer, commands: ptr<const<u8>>, size: u32) -> nkgpu_result;
	/**
	 * Creates a surface for the selected graphics backend associated with a
	 * NativeKit window.
	 *
	 * `nativekit_window` must be a valid NativeKit window handle, and `width` and
	 * `height` must be positive. The current adapter requests the configured
	 * graphics surface. On NKGPU_OK, writes the NativeKit surface handle to
	 * `out_surface`; destroy it with nkgpu_surface_destroy() after destroying its
	 * renderer. This convenience call requests the build's default API.
	 */
	extern fn nkgpu_surface_create(nativekit_window: nk_window, width: i32, height: i32, out_surface: ptr<nk_surface> @out) -> nkgpu_result;
	/**
	 * Creates a child surface with an explicit graphics API. The matching runtime
	 * must be included in this build; with the backend matrix enabled, GLCore and
	 * GLES3 surfaces can coexist.
	 */
	extern fn nkgpu_surface_create_for_api(nativekit_window: nk_window, api: nk_graphics_api, width: i32, height: i32, out_surface: ptr<nk_surface> @out) -> nkgpu_result;
	/**
	 * Destroys a GPU surface.
	 *
	 * Destroy the renderer first. The surface handle becomes invalid after this
	 * call and must not be reused.
	 */
	extern fn nkgpu_surface_destroy(surface: nk_surface) -> nkgpu_result;
	/**
	 * Requests a new size for a GPU surface.
	 *
	 * `width` and `height` are the surface's logical dimensions and must be
	 * positive. The framebuffer may have a different pixel size; begin each frame
	 * with nkgpu_begin_frame() so the adapter can query the current framebuffer.
	 */
	extern fn nkgpu_surface_resize(surface: nk_surface, width: i32, height: i32) -> nkgpu_result;
	/**
	 * Starts a zero-initialized uniform byte block of `size` bytes.
	 *
	 * Fill it with nkgpu_uniforms_write_f32(), then pass it to
	 * nkgpu_apply_uniforms(), which consumes the builder. The bytes must match the
	 * uniform block layout declared for the shader.
	 */
	extern fn nkgpu_uniforms_begin(renderer: nkgpu_renderer, size: u32, out_builder: ptr<nkgpu_uniform_builder> @out) -> nkgpu_result;
	/**
	 * Writes one 32-bit floating-point uniform value at a byte offset.
	 */
	extern fn nkgpu_uniforms_write_f32(builder: nkgpu_uniform_builder, offset: u32, value: f32) -> nkgpu_result;
	/**
	 * Load/store behavior for one render-pass attachment.
	 */
	struct nkgpu_attachment_action @layout(32, 4) {
		load_action: nkgpu_load_action @offset(0);
		store_action: nkgpu_store_action @offset(4);
		clear_color: nkgpu_color @offset(8);
		clear_depth: f32 @offset(24);
		clear_stencil: u32 @offset(28);
	}
	/**
	 * One render pass recorded into a submission batch.
	 */
	struct nkgpu_batch_pass @layout(32, 8) {
		/**
		 * Set to sizeof(nkgpu_batch_pass) or a larger compatible size.
		 */
		struct_size: u32 @offset(0) @struct_size;
		/**
		 * Selects how the pass target fields below are interpreted.
		 */
		kind: nkgpu_batch_pass_kind @offset(4);
		/**
		 * Offscreen target for NKGPU_BATCH_PASS_TARGET; ignored for other pass kinds.
		 */
		target: nkgpu_render_target @offset(8);
		/**
		 * Non-zero to clear the target at the start of the pass, zero to load it.
		 */
		clear: u32 @offset(12);
		/**
		 * Framebuffer width for NKGPU_BATCH_PASS_WINDOW; ignored for target/compute passes.
		 */
		width: u32 @offset(16);
		/**
		 * Framebuffer height for NKGPU_BATCH_PASS_WINDOW; ignored for target/compute passes.
		 */
		height: u32 @offset(20);
		/**
		 * General attachments for NKGPU_BATCH_PASS_RENDER; copied when appended.
		 */
		render_pass: ptr<const<nkgpu_render_pass_desc>> @offset(24);
	}
	/**
	 * Blend configuration for one color attachment.
	 */
	struct nkgpu_blend_state @layout(28, 4) {
		enabled: u32 @offset(0);
		src_rgb: nkgpu_blend_factor @offset(4);
		dst_rgb: nkgpu_blend_factor @offset(8);
		op_rgb: nkgpu_blend_op @offset(12);
		src_alpha: nkgpu_blend_factor @offset(16);
		dst_alpha: nkgpu_blend_factor @offset(20);
		op_alpha: nkgpu_blend_op @offset(24);
	}
	/**
	 * Describes a buffer-to-buffer transfer.
	 */
	struct nkgpu_buffer_copy_desc @layout(24, 4) {
		struct_size: u32 @offset(0) @struct_size;
		source: nkgpu_buffer @offset(4);
		source_offset: u32 @offset(8);
		destination: nkgpu_buffer @offset(12);
		destination_offset: u32 @offset(16);
		size: u32 @offset(20);
	}
	/**
	 * Descriptor for a general GPU buffer.
	 */
	struct nkgpu_buffer_desc @layout(40, 8) {
		struct_size: u32 @offset(0) @struct_size;
		size: u32 @offset(4);
		usage: nkgpu_buffer_usage @offset(8);
		data: ptr<const<u8>> @offset(16);
		data_size: u32 @offset(24);
		dynamic_update: u32 @offset(28);
		stream: u32 @offset(32);
	}
	/**
	 * Describes a buffer-to-image transfer. Coordinates use NativeKit's top-left origin.
	 */
	struct nkgpu_buffer_image_copy_desc @layout(44, 4) {
		struct_size: u32 @offset(0) @struct_size;
		buffer: nkgpu_buffer @offset(4);
		buffer_offset: u32 @offset(8);
		row_pitch: u32 @offset(12);
		image: nkgpu_image @offset(16);
		mip_level: u32 @offset(20);
		layer: u32 @offset(24);
		x: u32 @offset(28);
		y: u32 @offset(32);
		width: u32 @offset(36);
		height: u32 @offset(40);
	}
	/**
	 * An RGBA clear color used by render-pass actions.
	 */
	struct nkgpu_color @layout(16, 4) {
		r: f32 @offset(0);
		g: f32 @offset(4);
		b: f32 @offset(8);
		a: f32 @offset(12);
	}
	/**
	 * One color attachment and its optional multisample resolve image.
	 */
	struct nkgpu_color_attachment @layout(40, 4) {
		image: nkgpu_image @offset(0);
		resolve_image: nkgpu_image @offset(4);
		action: nkgpu_attachment_action @offset(8);
	}
	/**
	 * Versioned wrapper for packed command records.
	 */
	struct nkgpu_command_stream_desc @layout(24, 8) {
		struct_size: u32 @offset(0) @struct_size;
		version: u32 @offset(4);
		commands: ptr<const<u8>> @offset(8);
		size: u32 @offset(16);
	}
	/**
	 * Sets explicit depth compare, write, and polygon-offset state.
	 */
	struct nkgpu_depth_state @layout(24, 4) {
		enabled: u32 @offset(0);
		compare: nkgpu_compare_func @offset(4);
		write_enabled: u32 @offset(8);
		bias: f32 @offset(12);
		bias_slope_scale: f32 @offset(16);
		bias_clamp: f32 @offset(20);
	}
	/**
	 * Reports optional backend features through a backend-agnostic envelope.
	 */
	struct nkgpu_features @layout(40, 4) {
		struct_size: u32 @offset(0) @struct_size;
		mrt_count: u32 @offset(4);
		max_samples: u32 @offset(8);
		storage_buffer: u32 @offset(12);
		storage_image: u32 @offset(16);
		compute: u32 @offset(20);
		instancing: u32 @offset(24);
		buffer_copy: u32 @offset(28);
		image_copy: u32 @offset(32);
		image_readback: u32 @offset(36);
	}
	/**
	 * Describes a 2D image-region transfer. Coordinates use NativeKit's top-left origin.
	 */
	struct nkgpu_image_copy_desc @layout(52, 4) {
		struct_size: u32 @offset(0) @struct_size;
		source: nkgpu_image @offset(4);
		source_mip: u32 @offset(8);
		source_layer: u32 @offset(12);
		source_x: u32 @offset(16);
		source_y: u32 @offset(20);
		destination: nkgpu_image @offset(24);
		destination_mip: u32 @offset(28);
		destination_layer: u32 @offset(32);
		destination_x: u32 @offset(36);
		destination_y: u32 @offset(40);
		width: u32 @offset(44);
		height: u32 @offset(48);
	}
	/**
	 * Descriptor for a general 2D image or image array.
	 */
	struct nkgpu_image_desc @layout(56, 8) {
		struct_size: u32 @offset(0) @struct_size;
		width: u32 @offset(4);
		height: u32 @offset(8);
		format: nkgpu_image_format @offset(12);
		usage: nkgpu_image_usage @offset(16);
		mip_count: u32 @offset(20);
		sample_count: u32 @offset(24);
		layer_count: u32 @offset(28);
		data: ptr<const<u8>> @offset(32);
		data_size: u32 @offset(40);
		row_pitch: u32 @offset(44);
		dynamic_update: u32 @offset(48);
	}
	/**
	 * Describes one asynchronous image readback request.
	 */
	struct nkgpu_image_readback_desc @layout(32, 4) {
		struct_size: u32 @offset(0) @struct_size;
		image: nkgpu_image @offset(4);
		mip_level: u32 @offset(8);
		layer: u32 @offset(12);
		x: u32 @offset(16);
		y: u32 @offset(20);
		width: u32 @offset(24);
		height: u32 @offset(28);
	}
	/**
	 * Reports portable resource and binding limits for one renderer.
	 */
	struct nkgpu_limits @layout(32, 4) {
		struct_size: u32 @offset(0) @struct_size;
		max_texture_size: u32 @offset(4);
		max_array_layers: u32 @offset(8);
		max_vertex_attributes: u32 @offset(12);
		max_color_attachments: u32 @offset(16);
		max_texture_bindings: u32 @offset(20);
		max_storage_buffer_bindings: u32 @offset(24);
		max_storage_image_bindings: u32 @offset(28);
	}
	/**
	 * Opaque backend tokens for advanced native integration.
	 */
	struct nkgpu_native_context @layout(24, 8) {
		struct_size: u32 @offset(0) @struct_size;
		backend: nkgpu_backend @offset(4);
		device: u64 @offset(8);
		context: u64 @offset(16);
	}
	/**
	 * Reports readback state and the tightly packed result layout.
	 */
	struct nkgpu_readback_info @layout(24, 4) {
		struct_size: u32 @offset(0) @struct_size;
		state: nkgpu_readback_state @offset(4);
		size: u32 @offset(8);
		row_pitch: u32 @offset(12);
		width: u32 @offset(16);
		height: u32 @offset(20);
	}
	/**
	 * General render-pass description.
	 */
	struct nkgpu_render_pass_desc @layout(204, 4) {
		struct_size: u32 @offset(0) @struct_size;
		color_count: u32 @offset(4);
		colors: array<nkgpu_color_attachment, 4> @offset(8);
		depth_stencil: nkgpu_image @offset(168);
		depth_stencil_action: nkgpu_attachment_action @offset(172);
	}
	/**
	 * Resource, upload, and submission counters for one renderer.
	 */
	struct nkgpu_renderer_stats @layout(152, 8) {
		struct_size: u32 @offset(0);
		reserved: u32 @offset(4);
		frames: u64 @offset(8);
		passes: u64 @offset(16);
		draw_calls: u64 @offset(24);
		buffers_live: u64 @offset(32);
		images_live: u64 @offset(40);
		samplers_live: u64 @offset(48);
		shaders_live: u64 @offset(56);
		pipelines_live: u64 @offset(64);
		render_targets_live: u64 @offset(72);
		buffer_bytes: u64 @offset(80);
		image_bytes: u64 @offset(88);
		render_target_bytes: u64 @offset(96);
		upload_bytes: u64 @offset(104);
		resource_creations: u64 @offset(112);
		resource_destructions: u64 @offset(120);
		surface_recreations: u64 @offset(128);
		device_losses: u64 @offset(136);
		failed_allocations: u64 @offset(144);
	}
	/**
	 * General shader resource metadata retained by the shader builder.
	 */
	struct nkgpu_shader_binding_desc @layout(48, 8) {
		struct_size: u32 @offset(0) @struct_size;
		kind: nkgpu_shader_binding_kind @offset(4);
		stage: nkgpu_shader_stage @offset(8);
		slot: u32 @offset(12);
		/**
		 * Sampler slot for NKGPU_SHADERBINDING_SAMPLED_IMAGE.
		 */
		secondary_slot: u32 @offset(16);
		/**
		 * Byte size for NKGPU_SHADERBINDING_UNIFORM_BLOCK.
		 */
		size: u32 @offset(20);
		/**
		 * Access format for NKGPU_SHADERBINDING_STORAGE_IMAGE.
		 */
		format: nkgpu_image_format @offset(24);
		/**
		 * Non-zero for read-only storage-buffer metadata.
		 */
		readonly: u32 @offset(28);
		/**
		 * Non-zero for write-only storage-image metadata.
		 */
		writeonly: u32 @offset(32);
		/**
		 * GLSL combined image/sampler name for sampled-image metadata.
		 */
		name: utf8 @offset(40);
	}
	/**
	 * Operations applied to one stencil face.
	 */
	struct nkgpu_stencil_face_state @layout(16, 4) {
		compare: nkgpu_compare_func @offset(0);
		fail_op: nkgpu_stencil_op @offset(4);
		depth_fail_op: nkgpu_stencil_op @offset(8);
		pass_op: nkgpu_stencil_op @offset(12);
	}
	/**
	 * Stencil test configuration for both polygon faces.
	 */
	struct nkgpu_stencil_state @layout(40, 4) {
		enabled: u32 @offset(0);
		read_mask: u8 @offset(4);
		write_mask: u8 @offset(5);
		reference: u8 @offset(6);
		reserved: u8 @offset(7);
		front: nkgpu_stencil_face_state @offset(8);
		back: nkgpu_stencil_face_state @offset(24);
	}
	/**
	 * Sealed-submission batch handle returned by nkgpu_batch_begin().
	 */
	handle nkgpu_batch : u32;
	/**
	 * Buffer handle returned by nkgpu_buffer_create() or nkgpu_buffer_end().
	 */
	handle nkgpu_buffer : u32;
	/**
	 * Temporary builder handle returned by nkgpu_buffer_begin_kind().
	 */
	handle nkgpu_buffer_builder : u32;
	/**
	 * Image handle returned by nkgpu_image_end().
	 */
	handle nkgpu_image : u32;
	/**
	 * Temporary builder handle returned by nkgpu_image_begin().
	 */
	handle nkgpu_image_builder : u32;
	/**
	 * Source-compatible alias for a NativeKit window or surface handle.
	 */
	type nkgpu_nativekit_handle = nk_handle;
	/**
	 * Pipeline handle returned by nkgpu_pipeline_end().
	 */
	handle nkgpu_pipeline : u32;
	/**
	 * Temporary builder handle returned by nkgpu_pipeline_begin().
	 */
	handle nkgpu_pipeline_builder : u32;
	/**
	 * Asynchronous readback handle returned by nkgpu_readback_begin_image().
	 */
	handle nkgpu_readback : u32;
	/**
	 * Offscreen render target owned by a renderer.
	 */
	handle nkgpu_render_target : u32;
	/**
	 * Renderer handle returned by nkgpu_renderer_create(). It owns the adapter
	 * resources and unfinished builders created with it; renderer destruction
	 * releases all of them.
	 */
	handle nkgpu_renderer : u32;
	/**
	 * Sampler handle returned by nkgpu_sampler_create().
	 */
	handle nkgpu_sampler : u32;
	/**
	 * Shader handle returned by nkgpu_shader_create() or nkgpu_shader_end().
	 */
	handle nkgpu_shader : u32;
	/**
	 * Temporary builder handle returned by nkgpu_shader_begin().
	 */
	handle nkgpu_shader_builder : u32;
	/**
	 * Temporary builder handle returned by nkgpu_uniforms_begin().
	 */
	handle nkgpu_uniform_builder : u32;
}
