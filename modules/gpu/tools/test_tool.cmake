file(REMOVE_RECURSE "${OUTPUT}")
file(MAKE_DIRECTORY "${OUTPUT}")
file(COPY "${FIXTURES}/" DESTINATION "${OUTPUT}")

function(run mode)
    execute_process(COMMAND "${TOOL}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(mode STREQUAL "pass" AND NOT status EQUAL 0)
        message(FATAL_ERROR "Expected shader tool success: ${stdout}${stderr}")
    elseif(mode STREQUAL "stale" AND (status EQUAL 0 OR NOT stderr MATCHES "stale"))
        message(FATAL_ERROR "Expected stale output error: ${stderr}")
    elseif(mode STREQUAL "syntax" AND (status EQUAL 0 OR NOT stderr MATCHES "broken.glsl:[0-9]+:[0-9]+: error"))
        message(FATAL_ERROR "Expected a source diagnostic: ${stderr}")
    endif()
endfunction()

run(pass "${OUTPUT}/shaders.json")
run(pass "${OUTPUT}/shaders.json" --check)
file(READ "${OUTPUT}/fixture.json" reflection)
foreach(token IN ITEMS "\"preview\"" "\"palette.glsl\"" "\"array_stride\": 16" "\"sample_type\": \"float\"")
    string(FIND "${reflection}" "${token}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Missing reflection entry: ${token}")
    endif()
endforeach()
file(APPEND "${OUTPUT}/fixture.h" "\n")
run(stale "${OUTPUT}/shaders.json" --check)

run(pass --source "${OUTPUT}/fixture.glsl" --target hlsl5 --output "${OUTPUT}/single")
file(READ "${OUTPUT}/single/reflection.json" single)
if(NOT single MATCHES "\"hlsl5\"" OR single MATCHES "\"glsl410\"")
    message(FATAL_ERROR "Single-source mode must emit the selected target only")
endif()
file(READ "${OUTPUT}/single/dependencies" deps)
if(NOT deps MATCHES "palette.glsl")
    message(FATAL_ERROR "Single-source mode omitted its include")
endif()
foreach(targets IN ITEMS "glsl430:glsl310es:hlsl5:metal_macos" "hlsl5")
    string(REPLACE ":" "-" directory "${targets}")
    run(pass --source "${OUTPUT}/particles.glsl" --target "${targets}" --output "${OUTPUT}/${directory}")
    file(READ "${OUTPUT}/${directory}/reflection.json" compute)
    foreach(token IN ITEMS "\"stage\": \"compute\"" "\"name\": \"particles\"" "\"readonly\": false")
        string(FIND "${compute}" "${token}" found)
        if(found LESS 0)
            message(FATAL_ERROR "Missing compute reflection entry for ${targets}: ${token}\n${compute}")
        endif()
    endforeach()
endforeach()
file(READ "${OUTPUT}/glsl430-glsl310es-hlsl5-metal_macos/reflection.json" compute)
if(NOT compute MATCHES "\"x\": 64")
    message(FATAL_ERROR "Missing the Metal threadgroup size: ${compute}")
endif()
if(compute MATCHES "\"glsl410\"")
    message(FATAL_ERROR "Compute reflection emitted an unrequested target")
endif()
file(READ "${OUTPUT}/fixture.glsl" content)
string(REPLACE "shade_scale()" "unknown_function()" content "${content}")
file(WRITE "${OUTPUT}/broken.glsl" "${content}")
run(syntax --source "${OUTPUT}/broken.glsl" --target glsl410 --output "${OUTPUT}/broken")
message(STATUS "PASS: variants, includes, arrays, textures, compute, storage buffers, source diagnostics, and stale output")
