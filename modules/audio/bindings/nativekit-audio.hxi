		 * Amplitude attack duration in seconds.
		 */
		attack_seconds: f32 @offset(12);
		/**
		 * Amplitude decay duration in seconds.
		 */
		decay_seconds: f32 @offset(16);
		/**
		 * Sustained amplitude in the inclusive range [0, 1].
		 */
		sustain_level: f32 @offset(20);
		/**
		 * Amplitude release duration in seconds.
		 */
		release_seconds: f32 @offset(24);
		/**
		 * Reserved for compatible extensions; set all elements to zero.
		 */
		reserved2: array<u64, 2> @offset(32);
	}
	/**
	 * White-noise source component in a reusable patch.
	 */
	struct nk_audio_dsp_noise_options @layout(32, 8) {
		/**
		 * Set to sizeof(nk_audio_dsp_noise_options) before use.
		 */
		struct_size: u32 @offset(0) @struct_size;
		/**
		 * Linear source level in the inclusive range [0, 1].
		 */
		level: f32 @offset(4);
		/**
		 * Reserved; set to zero.
		 */
		reserved: u32 @offset(8);
		/**
		 * Reserved for compatible extensions; set all elements to zero.
		 */
		reserved2: array<u64, 2> @offset(16);
	}
	/**
	 * Oscillator source component in a reusable patch.
	 */
	struct nk_audio_dsp_oscillator_options @layout(32, 8) {
		/**
		 * Set to sizeof(nk_audio_dsp_oscillator_options) before use.
		 */
		struct_size: u32 @offset(0) @struct_size;
		/**
		 * Built-in oscillator shape.
		 */
		waveform: nk_audio_dsp_waveform @offset(4);
		/**
		 * Linear source level in the inclusive range [0, 1].
		 */
		level: f32 @offset(8);
		/**
		 * Reserved for compatible extensions; set all elements to zero.
		 */
		reserved2: array<u64, 2> @offset(16);
	}
	/**
	 * Immutable reusable DSP patch. Components are evaluated in source, envelope,
	 * filter, and output-gain order.
	 */
	struct nk_audio_dsp_patch_options @layout(168, 8) {
		/**
		 * Set to sizeof(nk_audio_dsp_patch_options) before use.
		 */
		struct_size: u32 @offset(0) @struct_size;
		/**
		 * Pitched oscillator source component.
		 */
		oscillator: nk_audio_dsp_oscillator_options @offset(8);
		/**
		 * White-noise source component.
		 */
		noise: nk_audio_dsp_noise_options @offset(40);
		/**
		 * Amplitude envelope component.
		 */
		envelope: nk_audio_dsp_envelope_options @offset(72);
		/**
		 * Optional filter component.
		 */
		filter: nk_audio_dsp_filter_options @offset(112);
		/**
		 * Linear output gain; zero is silent.
		 */
		gain: f32 @offset(144);
		/**
		 * Reserved for compatible extensions; set all elements to zero.
		 */
		reserved2: array<u64, 2> @offset(152);
	}
	/**
	 * Interleaved float output supplied to nk_audio_dsp_engine_render.
	 */
	struct nk_audio_dsp_render_target @layout(32, 8) {
		/**
		 * Set to sizeof(nk_audio_dsp_render_target) before passing the structure.
		 */
		struct_size: u32 @offset(0) @struct_size;
		/**
		 * Interleaved destination samples, with frame_count * channels elements.
		 */
		samples: ptr<f32> @offset(8);
		/**
		 * Number of PCM frames to render. Must not exceed the engine block size.
		 */
		frame_count: u32 @offset(16);
		/**
		 * Number of interleaved channels; must match the engine configuration.
		 */
		channels: u32 @offset(20);
		/**
		 * Number of float elements available at samples.
		 */
		sample_count: u64 @offset(24);
	}
	/**
	 * Three-dimensional audio coordinate in the right-handed OpenGL convention.
	 */
	struct nk_audio_vec3 @layout(12, 4) {
		/**
		 * Positive X points right.
		 */
		x: f32 @offset(0);
		/**
		 * Positive Y points up.
		 */
		y: f32 @offset(4);
		/**
		 * Negative Z points forward.
		 */
		z: f32 @offset(8);
	}
	/**
	 * Optional creation settings for a voice.
	 */
	struct nk_audio_voice_options @layout(24, 8) {
		/**
		 * Set to sizeof(nk_audio_voice_options) before passing the structure.
		 */
		struct_size: u32 @offset(0) @struct_size;
		/**
		 * Combination of NK_AUDIO_VOICE_* flags.
		 */
		flags: nk_audio_voice_flags @offset(4);
		/**
		 * Reserved for compatible extensions; set all elements to zero.
		 */
		reserved2: array<u64, 2> @offset(8);
	}
	/**
	 * One user-visible name and glob pattern set for a URI-resource dialog.
	 */
	struct nk_dialog_filter @layout(16, 8) {
		/**
		 * Optional label shown for the filter.
		 */
		name: nullable<utf8> @offset(0);
		/**
		 * Semicolon-separated UTF-8 glob patterns, for example "*.png;*.jpg".
		 */
		patterns: utf8 @offset(8);
	}
	/**
	 * Payload of NK_EVENT_DIALOG_MESSAGE_COMPLETE.
	 */
	struct nk_dialog_message_result @layout(4, 4) {
		/**
		 * Button selected by the user, or NK_MESSAGE_RESULT_NONE on cancellation.
		 */
		button: nk_message_result @offset(0);
	}
	/**
	 * Options for URI-resource dialogs.
	 */
	struct nk_file_dialog_options @layout(48, 8) {
		/**
		 * Set to sizeof(nk_file_dialog_options) before starting the dialog.
		 */
		struct_size: u32 @offset(0) @struct_size;
		/**
		 * Bitwise OR of NK_DIALOG_* flags.
		 */
		flags: nk_dialog_flags @offset(4);
		/**
		 * Optional dialog title.
		 */
		title: nullable<utf8> @offset(8);
		/**
		 * Optional initial URI or platform resource location.
		 */
		initial_path: nullable<utf8> @offset(16);
		/**
		 * Optional suggested filename for save operations.
		 */
		suggested_name: nullable<utf8> @offset(24);
		/**
		 * Caller-owned filters read during the call and copied by NativeKit.
		 */
		filters: ptr<const<nk_dialog_filter>> @offset(32) @borrowed @length_field("filter_count");
		/**
		 * Number of entries in `filters`.
		 */
		filter_count: u32 @offset(40);
		/**
		 * Reserved; set to zero.
		 */
		reserved: u32 @offset(44);
	}
	/**
	 * Options for a native message dialog.
	 */
	struct nk_message_dialog_options @layout(32, 8) {
		/**
		 * Set to sizeof(nk_message_dialog_options) before starting the dialog.
		 */
		struct_size: u32 @offset(0) @struct_size;
		/**
		 * Message presentation kind.
		 */
		kind: nk_message_kind @offset(4);
		/**
		 * Bitwise OR of NK_MESSAGE_BUTTON_* values; zero defaults to OK.
		 */
		buttons: nk_message_buttons @offset(8);
		/**
		 * Reserved; set to zero.
		 */
		reserved: u32 @offset(12);
		/**
		 * Optional dialog title.
		 */
		title: nullable<utf8> @offset(16);
		/**
		 * Required UTF-8 message text.
		 */
		message: utf8 @offset(24);
	}
	/**
	 * Opaque handle for one audio mixer bus.
	 */
	handle nk_audio_bus : u32 @destroy("nk_audio_bus_destroy");
	/**
	 * Opaque handle for one effect inserted into an audio mixer bus.
	 */
	handle nk_audio_bus_effect : u32 @destroy("nk_audio_bus_effect_destroy");
	/**
	 * Opaque handle for one reusable audio clip source.
	 */
	handle nk_audio_clip : u32 @destroy("nk_audio_clip_destroy");
	/**
	 * Opaque handle for one standalone DSP renderer.
	 */
	handle nk_audio_dsp_engine : u32 @destroy("nk_audio_dsp_engine_destroy");
	/**
	 * Opaque handle for one instrument owned by a DSP renderer.
	 */
	handle nk_audio_dsp_instrument : u32 @destroy("nk_audio_dsp_instrument_destroy");
	/**
	 * Opaque handle for an immutable, reusable DSP patch definition.
	 */
	handle nk_audio_dsp_patch : u32 @destroy("nk_audio_dsp_patch_destroy");
	/**
	 * Opaque handle for one reusable set of mixer bus targets.
	 */
	handle nk_audio_mix_snapshot : u32 @destroy("nk_audio_mix_snapshot_destroy");
	/**
	 * Opaque handle for one independent playback voice.
	 */
	handle nk_audio_voice : u32 @destroy("nk_audio_voice_destroy");
}
