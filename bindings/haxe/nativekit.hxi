	 * thread and requires NK_CAP_ACCESSIBILITY.
	 */
	extern fn nk_surface_accessibility_remove_node(surface: nk_surface, node: nk_accessibility_node_id) -> nk_result;
	/**
	 * Moves accessibility focus to a virtual node.
